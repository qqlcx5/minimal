page {
  width: 100%;
  height: 100%;
}
.containerRow 
{
  width: 100%;
  height: auto;
  min-height: 100%;
  background-color: #f8f8f8;
  position: relative;
  display: flex;
  flex-direction: column;
}
/* 固定高度 */
.fixedHeight
{
  flex: 0 0 auto;
  padding: 16rpx 28rpx;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
  backdrop-filter: blur(10rpx);
}/* 自适应高度 */
.autoFullHeight
{
  flex: 1 1 auto;
  position: relative;
}
.containerColumn
{
  background-color: transparent;
  position: absolute;
  display: flex;
  flex-direction: row;
  top: 0;right: 0;bottom: 0;left: 0;
}
/* 固定宽度 */
.fixedWidth
{
  flex: 0 0 auto;
}
/* 自适应宽度 */
.autoFullWidth
{
  flex: 1 1 auto;
  position: relative;
}
.map {
  display: flex;position: absolute;top: 0;right: 0;bottom: 0;left: 0;
  width: 100%;
  height: 100%;
} 

.page-body-title{
   display: inline-flex;
   width: 180px;
   font-size: 28rpx;
   color: #fff;
   align-items: center;
}
.page-info{
  display: inline-flex;
  width: 140px;
  font-size: 30rpx;
  color: #fff;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  font-weight: 500;
}
.page-checkbox{
 justify-content: center;
  display: inline-table;width: 100px;
}


.page-info-right{
  right: 20rpx;
  position: absolute;
  display: inline-flex;
  width: 100px;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  padding: 6rpx 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
  font-weight: 600;
}

/* 状态指示器 */
fixedHeight text[style*="background-color"] {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.power-info{
  display: inline-flex;width: 90px;
  font-size: 25px;
  justify-content: center;
}
.power-slider{
    border-radius: 0px;
    height: 80%;
    top: 10%;
    position: relative;
    justify-content: center;
}
.power-button{
    align-items: center;
    padding-left: 1px;
    border-radius: 8px;
    display: flex;
    size: 100%;
    width: 80px;
    height: 60px;
    font-size: 20px;
}
.rudder-slider{
  border-radius: 0px;
  width: 50%;
  left: 5%;
  position: relative;
  justify-content: center;
}
.rudder-button{
  justify-content: center;
  border-radius: 8px;
  background-color: gray;
  display: flex;
  size: 100%;
  width: 60px;
  height: 50px;
  font-size: 20px;
}
.transparent-button:not([size="mini"]){
  width: 100%;
  margin-top: 20px;
  padding: 0;
  font-size: 20px;
  font-weight: lighter;
}
.map-button{
  position: absolute;
  background-color: transparent;
  display: flex;
  flex-direction: row;
}
.map-button1{
  margin-left: 20px;
  position: relative;
  background-color: transparent;
  width: 98px;
  display: flex;
  flex-direction: column;
}
.map-settings{
  margin-left: 20px;
  position: relative;
  background-color: transparent;
  width: 150px;
  display: flex;
  flex-direction: column;
}